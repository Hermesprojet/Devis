# ---------------------------------------------------------------------------
# Metreo — exemple de configuration.
# Copiez ce fichier en `.env` et complétez. NE COMMITEZ JAMAIS de `.env`.
# Aucune valeur ci-dessous n'est un secret utilisable.
# ---------------------------------------------------------------------------

# Environnement: development | test | staging | production
METREO_ENVIRONMENT=development

# --- Base de données -------------------------------------------------------
# Docker Compose fournit PostgreSQL 16 + PostGIS sur le port 5432.
METREO_DATABASE_URL=postgresql+psycopg://metreo:metreo@localhost:5432/metreo
# Pour un démarrage sans service, SQLite suffit (refusé en staging/production):
# METREO_DATABASE_URL=sqlite+pysqlite:///./var/metreo.sqlite3
METREO_SQL_ECHO=false

# --- Authentification ------------------------------------------------------
# dev : jetons émis sans mot de passe pour les utilisateurs de démonstration.
#       Refusé si METREO_ENVIRONMENT vaut staging ou production.
# jwt : jetons signés uniquement (OIDC/OAuth2 prévu en phase 5).
METREO_AUTH_MODE=dev
# Obligatoire hors développement. Générez-le: openssl rand -hex 32
METREO_JWT_SECRET=
METREO_JWT_TTL_SECONDS=28800

# --- Stockage --------------------------------------------------------------
METREO_STORAGE_ROOT=./var/storage
METREO_MAX_UPLOAD_BYTES=26214400

# --- IA / OCR --------------------------------------------------------------
# Phase 1 n'embarque aucun fournisseur. Le produit doit rester utilisable
# avec ia désactivée (scénario d'acceptation n° 10).
METREO_AI_ENABLED=false
METREO_AI_PROVIDER=null

# --- Divers ----------------------------------------------------------------
METREO_CORS_ORIGINS=http://localhost:3000
METREO_DEFAULT_CURRENCY=EUR
METREO_DEFAULT_LOCALE=fr-BE

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- PostgreSQL (docker compose) -------------------------------------------
POSTGRES_USER=metreo
POSTGRES_PASSWORD=metreo
POSTGRES_DB=metreo
