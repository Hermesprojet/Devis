# ---------------------------------------------------------------------------
# Metreo — exemple de configuration.
# Copiez ce fichier en `.env` et complétez. NE COMMITEZ JAMAIS de `.env`.
# Aucune valeur ci-dessous n'est un secret utilisable.
# ---------------------------------------------------------------------------

# Environnement: development | test | staging | production
METREO_ENVIRONMENT=development

# --- Base de données -------------------------------------------------------
# Docker Compose fournit PostgreSQL 16 + PostGIS sur le port 5432.
METREO_DATABASE_URL=postgresql+psycopg://metreo:metreo@localhost:5432/metreo
# Pour un démarrage sans service, SQLite suffit (refusé en staging/production):
# METREO_DATABASE_URL=sqlite+pysqlite:///./var/metreo.sqlite3
METREO_SQL_ECHO=false

# --- Authentification ------------------------------------------------------
# dev  : jetons émis sans mot de passe pour les utilisateurs de démonstration.
#        Refusé si METREO_ENVIRONMENT vaut staging ou production.
# oidc : Authorization Code + PKCE contre un fournisseur externe. Seul mode
#        utilisable en préproduction et en production : c'est le seul qui
#        donne à un navigateur un moyen d'obtenir un jeton.
# jwt  : jetons signés acceptés tels quels, sans parcours de connexion. Utile
#        à une intégration machine, insuffisant pour un navigateur — refusé
#        en staging/production pour cette raison.
METREO_AUTH_MODE=dev
# Obligatoire hors développement. Générez-le: openssl rand -hex 32
METREO_JWT_SECRET=
METREO_JWT_TTL_SECONDS=28800

# --- OIDC (obligatoire quand METREO_AUTH_MODE=oidc) -------------------------
# L'émetteur suffit : tout le reste est lu dans
# <issuer>/.well-known/openid-configuration. Aucun chemin n'est codé en dur,
# donc n'importe quel fournisseur conforme convient.
METREO_OIDC_ISSUER=
METREO_OIDC_CLIENT_ID=
# Secret client. NE LE COMMITEZ JAMAIS : passez-le par le gestionnaire de
# secrets de la plateforme, pas par un fichier versionné.
METREO_OIDC_CLIENT_SECRET=
# URL exacte enregistrée chez le fournisseur, côté APPLICATION (pas l'API) :
# c'est le navigateur qui y revient, sur l'écran de connexion — qui est la
# RACINE de l'application, et non une page dédiée. Une valeur qui désigne une
# page inexistante déposerait l'utilisateur sur un 404, son code de connexion
# en main, après une authentification pourtant réussie. Exemple :
# METREO_OIDC_REDIRECT_URI=https://app.example.invalid/
METREO_OIDC_REDIRECT_URI=
METREO_OIDC_SCOPES=openid email profile
# Durée de vie du code de connexion opaque rendu au navigateur, en secondes.
METREO_OIDC_LOGIN_CODE_TTL_SECONDS=120
# Fenêtre entre le départ vers le fournisseur et le retour, en secondes.
METREO_OIDC_TRANSACTION_TTL_SECONDS=600

# --- Stockage --------------------------------------------------------------
METREO_STORAGE_ROOT=./var/storage
METREO_MAX_UPLOAD_BYTES=26214400

# --- IA / OCR --------------------------------------------------------------
# Phase 1 n'embarque aucun fournisseur. Le produit doit rester utilisable
# avec ia désactivée (scénario d'acceptation n° 10).
METREO_AI_ENABLED=false
METREO_AI_PROVIDER=null

# --- Divers ----------------------------------------------------------------
METREO_CORS_ORIGINS=http://localhost:3000
METREO_DEFAULT_CURRENCY=EUR
METREO_DEFAULT_LOCALE=fr-BE

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- PostgreSQL (docker compose) -------------------------------------------
POSTGRES_USER=metreo
POSTGRES_PASSWORD=metreo
POSTGRES_DB=metreo
