# Une seule origine pour le front et l'API.
#
# `/api/*` va à l'API, tout le reste au front. Le navigateur ne voit qu'un
# domaine : pas de CORS, pas de cookie tiers, pas de seconde entrée DNS.
# HTTPS est terminé ici ; les deux applications parlent en clair sur le réseau
# interne de la composition, qui n'est pas exposé.

{$PUBLIC_HOST} {
	encode zstd gzip

	# Un identifiant de corrélation posé ici, avant tout le reste : le proxy
	# et l'application journalisent alors la même requête sous le même
	# identifiant. Sans lui, l'API en génère un de son côté, et rapprocher une
	# erreur 502 vue par le proxy de la requête vue par l'application se fait à
	# la main, sur l'horodatage.
	#
	# Le matcher conserve un identifiant déjà fourni par un client : le
	# modificateur `?` de `request_header`, qui dirait la même chose en plus
	# court, ne vaut que pour les en-têtes de RÉPONSE. Caddy refuse d'adapter
	# la configuration si on l'emploie ici, et le contrôle en CI le montre.
	# L'API remplace ensuite ce qui dépasse 64 caractères.
	@sans_identifiant not header X-Request-Id *
	request_header @sans_identifiant X-Request-Id {http.request.uuid}

	# Un premier plafond de corps, posé au plus tôt.
	#
	# Il DOUBLE la garde de l'application, il ne la remplace pas. Le proxy
	# épargne au réseau interne et à l'API le transport d'un corps démesuré ;
	# mais l'API est aussi appelée directement — dans les tests, depuis le
	# réseau de la composition, sur son port interne — et une protection qui
	# ne vivrait qu'ici disparaîtrait dans tous ces cas. Voir
	# `apps/api/src/metreo_api/garde_de_corps.py`.
	#
	# La valeur couvre le plus haut plafond applicatif — 25 Mio pour une pièce
	# de chantier — plus l'enveloppe multipart. La poser plus BAS casserait un
	# téléversement que l'API accepte, et le défaut ne se verrait qu'en
	# production, sur un fichier volumineux ; un test la tient au-dessus.
	request_body {
		max_size {$MAX_BODY_SIZE:26MiB}
	}

	# L'API d'abord : la règle la plus spécifique gagne.
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}

	# En-têtes que le proxy pose pour tout le monde. `Cache-Control: no-store`
	# vient déjà de l'API pour ses propres réponses ; ceux-ci concernent le
	# navigateur et le transport.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	log {
		output stdout
		format json
	}

	# Le format JSON de Caddy ne journalise pas les en-têtes de requête par
	# défaut. Celui-ci porte la corrélation : sans cette ligne, l'identifiant
	# est posé mais invisible côté proxy, et ne relie donc rien.
	log_append request>headers>X-Request-Id {http.request.header.X-Request-Id}
}
