# ---------------------------------------------------------------------------
# Préproduction — exemple. Copiez en `infra/staging.env` et complétez.
# `infra/staging.env` est ignoré par Git : NE LE COMMITEZ JAMAIS.
# Aucune valeur ci-dessous n'est un secret utilisable.
# ---------------------------------------------------------------------------

# --- Identité publique -----------------------------------------------------
# Le nom que sert le proxy, et l'origine que le navigateur voit.
PUBLIC_HOST=app.example.invalid
PUBLIC_ORIGIN=https://app.example.invalid
HTTP_PORT=80
HTTPS_PORT=443

# --- Images ----------------------------------------------------------------
# Identifiées par le SHA Git, jamais par `latest` : un `latest` ne dit pas ce
# qui tourne, et un rollback n'a alors plus de cible.
# Exemple : ghcr.io/hermesprojet/metreo-api:4604b7a8
API_IMAGE=
WEB_IMAGE=

# --- Base de données -------------------------------------------------------
POSTGRES_USER=metreo
POSTGRES_PASSWORD=
POSTGRES_DB=metreo

# --- Application -----------------------------------------------------------
METREO_ENVIRONMENT=staging
METREO_AUTH_MODE=oidc
# Générez-le : openssl rand -hex 32
METREO_JWT_SECRET=

# --- OIDC ------------------------------------------------------------------
# L'émetteur suffit : le reste est lu dans son document de découverte.
METREO_OIDC_ISSUER=https://issuer.example.invalid
METREO_OIDC_CLIENT_ID=metreo-staging
METREO_OIDC_CLIENT_SECRET=
# Doit être enregistrée TELLE QUELLE chez le fournisseur, et pointer sur
# l'écran de connexion — qui est la racine de l'application, pas une page
# dédiée. Une valeur qui désigne une page inexistante déposerait l'utilisateur
# sur un 404, son code de connexion en main, après une authentification
# pourtant réussie.
METREO_OIDC_REDIRECT_URI=https://app.example.invalid/

# --- Sauvegardes -----------------------------------------------------------
# Destination des archives chiffrées. Vide = sauvegarde locale seulement, ce
# qui ne protège de rien si la machine disparaît.
BACKUP_DESTINATION=
# Clé publique age du destinataire des sauvegardes (chiffrement).
# Générez une paire : age-keygen -o cle-de-sauvegarde.txt
BACKUP_AGE_RECIPIENT=
