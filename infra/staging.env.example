# ---------------------------------------------------------------------------
# Préproduction — exemple. Copiez en `infra/staging.env` et complétez.
# `infra/staging.env` est ignoré par Git : NE LE COMMITEZ JAMAIS.
# Aucune valeur ci-dessous n'est un secret utilisable.
# ---------------------------------------------------------------------------

# --- Identité publique -----------------------------------------------------
# Le nom que sert le proxy, et l'origine que le navigateur voit.
# DERRIÈRE UN PROXY DÉJÀ EN PLACE sur la machine (Traefik, Nginx Proxy
# Manager, un autre Caddy), ajoutez `infra/docker-compose.derriere-proxy.yml`
# et posez ici le SCHÉMA explicite plus le nom seul :
#
#   PUBLIC_HOST=http://preprod.metreobtp.com
#   PUBLIC_DOMAIN=preprod.metreobtp.com
#   # Facultatifs : le port local où joindre Caddy (défaut 8081), et le nom
#   # du résolveur de certificats déclaré dans le Traefik de la machine
#   # (défaut letsencrypt). Les scripts d'exploitation lisent ce fichier
#   # ligne à ligne ; un commentaire en FIN de ligne y ferait partie de la
#   # valeur. Gardez-les sur leur propre ligne, comme ici.
#   HTTP_DIAGNOSTIC_PORT=8081
#   TRAEFIK_CERT_RESOLVER=letsencrypt
#
# Le `http://` dit à Caddy de servir en clair et de ne demander AUCUN
# certificat — c'est le proxy de devant qui le possède. Sans ce schéma, Caddy
# redirige vers https, le proxy lui retransmet, et la boucle est complète.
#
# Sans proxy devant, gardez la forme ci-dessous, sans schéma : Caddy prend
# alors 80 et 443 et obtient le certificat lui-même.
PUBLIC_HOST=preprod.metreobtp.com
PUBLIC_ORIGIN=https://preprod.metreobtp.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Images ----------------------------------------------------------------
# Identifiées par le SHA Git, jamais par `latest` : un `latest` ne dit pas ce
# qui tourne, et un rollback n'a alors plus de cible.
# Exemple : ghcr.io/hermesprojet/metreo-api:4604b7a8
API_IMAGE=
WEB_IMAGE=

# --- Base de données -------------------------------------------------------
POSTGRES_USER=metreo
POSTGRES_PASSWORD=
POSTGRES_DB=metreo

# --- Application -----------------------------------------------------------
METREO_ENVIRONMENT=staging
METREO_AUTH_MODE=oidc
# Générez-le : openssl rand -hex 32
METREO_JWT_SECRET=

# --- OIDC ------------------------------------------------------------------
# L'émetteur suffit : le reste est lu dans son document de découverte.
METREO_OIDC_ISSUER=https://issuer.example.invalid
METREO_OIDC_CLIENT_ID=metreo-staging
METREO_OIDC_CLIENT_SECRET=
# Doit être enregistrée TELLE QUELLE chez le fournisseur, et pointer sur
# l'écran de connexion — qui est la racine de l'application, pas une page
# dédiée. Une valeur qui désigne une page inexistante déposerait l'utilisateur
# sur un 404, son code de connexion en main, après une authentification
# pourtant réussie.
METREO_OIDC_REDIRECT_URI=https://preprod.metreobtp.com/

# --- Sauvegardes -----------------------------------------------------------
# Destination des archives chiffrées. Vide = sauvegarde locale seulement, ce
# qui ne protège de rien si la machine disparaît.
BACKUP_DESTINATION=
# Clé publique age du destinataire des sauvegardes (chiffrement).
# Générez une paire : age-keygen -o cle-de-sauvegarde.txt
BACKUP_AGE_RECIPIENT=
