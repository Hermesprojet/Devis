# Valeurs de la RÉPÉTITION de préproduction. Ce fichier est un exemple, et il
# est versionné : il ne contient donc aucun secret réel, et n'en contiendra
# jamais. Les valeurs ci-dessous n'ouvrent rien — elles ne vivent que le temps
# d'une exécution de workflow, sur une pile liée à la boucle locale.
#
# Le workflow .github/workflows/repetition-staging.yml en fabrique sa propre
# copie ; ce fichier sert à rejouer la répétition à la main.

PUBLIC_HOST=http://localhost:8080
PUBLIC_ORIGIN=http://localhost:8080

POSTGRES_USER=metreo_repetition
POSTGRES_DB=metreo_repetition
POSTGRES_PASSWORD=repetition-ephemere-sans-valeur

METREO_ENVIRONMENT=staging
METREO_AUTH_MODE=oidc
METREO_JWT_SECRET=repetition-ephemere-sans-valeur-0123456789abcdef

# Le faux fournisseur, joint par son nom de service dans le réseau de la pile.
METREO_OIDC_ISSUER=http://oidc:8021
METREO_OIDC_CLIENT_ID=metreo-repetition
METREO_OIDC_CLIENT_SECRET=repetition-ephemere-sans-valeur
# L'écran de connexion est la racine de l'application, pas une page dédiée.
METREO_OIDC_REDIRECT_URI=http://localhost:8080/

# Étiquetées par le SHA du commit répété. Le workflow les remplace.
API_IMAGE=metreo-api:repetition
WEB_IMAGE=metreo-web:repetition
